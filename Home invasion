 import asyncio
import sys
import pygame

# Initialize Pygame & Audio Mixer
pygame.init()
pygame.mixer.init()

# Display Configuration
SCREEN_WIDTH, SCREEN_HEIGHT = 800, 600
screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
pygame.display.set_caption("Mouse Escape: House Dash")
clock = pygame.time.Clock()
FPS = 60

# Colors
COLOR_BG = (35, 25, 45)
COLOR_MOUSE = (180, 140, 100)
COLOR_PLATFORM = (110, 75, 45)
COLOR_CHEESE = (255, 205, 0)
COLOR_HAZARD = (220, 60, 60)
COLOR_DOOR = (50, 205, 50)
COLOR_UI = (255, 255, 255)
COLOR_DASH = (0, 200, 255)


class Player(pygame.sprite.Sprite):

    def __init__(self, x, y):
        super().__init__()
        self.image = pygame.Surface((32, 22), pygame.SRCALPHA)
        self.rect = self.image.get_rect(topleft=(x, y))
        self.redraw()

        self.vel_x = 0
        self.vel_y = 0
        self.speed = 5
        self.jump_power = -11
        self.gravity = 0.55
        self.on_ground = False

        self.health = 3
        self.cheese_collected = 0
        self.is_dashing = False
        self.dash_timer = 0
        self.dash_cooldown = 0
        self.invulnerable_timer = 0

    def redraw(self):
        self.image.fill((0, 0, 0, 0))
        color = COLOR_DASH if self.is_dashing else COLOR_MOUSE
        pygame.draw.ellipse(self.image, color, (4, 4, 24, 16))
        pygame.draw.circle(self.image, (220, 150, 150), (8, 6), 4)
        pygame.draw.line(self.image, COLOR_MOUSE, (4, 14), (0, 18), 2)

    def handle_input(self, keys, touch):
        if self.is_dashing:
            return

        self.vel_x = 0
        if keys[pygame.K_LEFT] or keys[pygame.K_a] or touch.left:
            self.vel_x = -self.speed
        if keys[pygame.K_RIGHT] or keys[pygame.K_d] or touch.right:
            self.vel_x = self.speed

        if (
            keys[pygame.K_SPACE]
            or keys[pygame.K_UP]
            or keys[pygame.K_w]
            or touch.jump
        ) and self.on_ground:
            self.vel_y = self.jump_power
            self.on_ground = False

        if (
            keys[pygame.K_LSHIFT]
            or keys[pygame.K_RSHIFT]
            or touch.dash
        ) and self.dash_cooldown <= 0:
            direction = -1 if self.vel_x < 0 else (1 if self.vel_x > 0 else 1)
            self.vel_x = direction * 14
            self.vel_y = 0
            self.is_dashing = True
            self.dash_timer = 12
            self.dash_cooldown = 60
            self.invulnerable_timer = 15
            self.redraw()

    def update(self, platforms):
        if self.dash_timer > 0:
            self.dash_timer -= 1
            if self.dash_timer == 0:
                self.is_dashing = False
                self.redraw()
        else:
            self.vel_y += self.gravity
            if self.vel_y > 10:
                self.vel_y = 10

        if self.dash_cooldown > 0:
            self.dash_cooldown -= 1

        if self.invulnerable_timer > 0:
            self.invulnerable_timer -= 1

        self.rect.x += self.vel_x
        for plat in platforms:
            if self.rect.colliderect(plat.rect):
                if self.vel_x > 0:
                    self.rect.right = plat.rect.left
                elif self.vel_x < 0:
                    self.rect.left = plat.rect.right

        self.rect.y += self.vel_y
        self.on_ground = False
        for plat in platforms:
            if self.rect.colliderect(plat.rect):
                if self.vel_y > 0:
                    self.rect.bottom = plat.rect.top
                    self.vel_y = 0
                    self.on_ground = True
                elif self.vel_y < 0:
                    self.rect.top = plat.rect.bottom
                    self.vel_y = 0

    def take_damage(self):
        if self.invulnerable_timer <= 0 and not self.is_dashing:
            self.health -= 1
            self.invulnerable_timer = 60
            self.vel_y = -6
            return True
        return False


class Platform(pygame.sprite.Sprite):

    def __init__(self, x, y, width, height):
        super().__init__()
        self.image = pygame.Surface((width, height))
        self.image.fill(COLOR_PLATFORM)
        self.rect = self.image.get_rect(topleft=(x, y))


class Hazard(pygame.sprite.Sprite):

    def __init__(self, x, y, width, height, move_range=0, speed=2):
        super().__init__()
        self.image = pygame.Surface((width, height))
        self.image.fill(COLOR_HAZARD)
        self.rect = self.image.get_rect(topleft=(x, y))
        self.start_x = x
        self.move_range = move_range
        self.speed = speed

    def update(self):
        if self.move_range > 0:
            self.rect.x += self.speed
            if abs(self.rect.x - self.start_x) > self.move_range:
                self.speed *= -1


class Cheese(pygame.sprite.Sprite):

    def __init__(self, x, y):
        super().__init__()
        self.image = pygame.Surface((18, 14), pygame.SRCALPHA)
        pygame.draw.polygon(
            self.image, COLOR_CHEESE, [(0, 14), (18, 14), (18, 0)]
        )
        self.rect = self.image.get_rect(topleft=(x, y))


class Goal(pygame.sprite.Sprite):

    def __init__(self, x, y):
        super().__init__()
        self.image = pygame.Surface((35, 60))
        self.image.fill(COLOR_DOOR)
        self.rect = self.image.get_rect(topleft=(x, y))


class TouchControls:

    def __init__(self):
        self.left_btn = pygame.Rect(20, 480, 70, 70)
        self.right_btn = pygame.Rect(100, 480, 70, 70)
        self.jump_btn = pygame.Rect(620, 480, 70, 70)
        self.dash_btn = pygame.Rect(700, 480, 70, 70)

        self.left = False
        self.right = False
        self.jump = False
        self.dash = False

        self.surface = pygame.Surface(
            (SCREEN_WIDTH, SCREEN_HEIGHT), pygame.SRCALPHA
        )

    def process(self):
        self.left = self.right = self.jump = self.dash = False
        mouse_pos = pygame.mouse.get_pos()
        mouse_pressed = pygame.mouse.get_pressed()[0]

        if mouse_pressed:
            if self.left_btn.collidepoint(mouse_pos):
                self.left = True
            if self.right_btn.collidepoint(mouse_pos):
                self.right = True
            if self.jump_btn.collidepoint(mouse_pos):
                self.jump = True
            if self.dash_btn.collidepoint(mouse_pos):
                self.dash = True

    def draw(self, surface):
        self.surface.fill((0, 0, 0, 0))
        for btn, _ in [
            (self.left_btn, "<"),
            (self.right_btn, ">"),
            (self.jump_btn, "JUMP"),
            (self.dash_btn, "DASH"),
        ]:
            pygame.draw.rect(
                self.surface, (255, 255, 255, 80), btn, border_radius=12
            )
        surface.blit(self.surface, (0, 0))


class LevelManager:

    def __init__(self):
        self.current_level = 1
        self.max_level = 4

    def load_level(self, level_num):
        all_sprites = pygame.sprite.Group()
        platforms = pygame.sprite.Group()
        hazards = pygame.sprite.Group()
        cheeses = pygame.sprite.Group()

        floor = Platform(0, 550, 800, 50)
        platforms.add(floor)
        all_sprites.add(floor)

        if level_num == 1:
            player = Player(40, 500)
            door = Goal(730, 490)
            plat_list = [
                Platform(150, 440, 120, 20),
                Platform(320, 350, 140, 20),
                Platform(520, 260, 120, 20),
                Platform(680, 180, 100, 20),
            ]
            hazard_list = [
                Hazard(200, 520, 40, 30, move_range=150, speed=3),
                Hazard(350, 320, 30, 30, move_range=80, speed=2),
            ]
            cheese_list = [
                Cheese(180, 410),
                Cheese(360, 320),
                Cheese(550, 230),
            ]
        elif level_num == 2:
            player = Player(40, 500)
            door = Goal(730, 120)
            plat_list = [
                Platform(120, 450, 100, 20),
                Platform(270, 370, 120, 20),
                Platform(440, 290, 120, 20),
                Platform(610, 200, 100, 20),
            ]
            hazard_list = [
                Hazard(150, 520, 50, 30, move_range=300, speed=4),
                Hazard(300, 340, 25, 30, move_range=60, speed=3),
            ]
            cheese_list = [
                Cheese(150, 420),
                Cheese(470, 260),
                Cheese(640, 170),
            ]
        elif level_num == 3:
            player = Player(40, 500)
            door = Goal(730, 490)
            plat_list = [
                Platform(140, 430, 110, 20),
                Platform(300, 330, 110, 20),
                Platform(470, 430, 110, 20),
                Platform(600, 280, 100, 20),
            ]
            hazard_list = [
                Hazard(180, 520, 60, 30, move_range=400, speed=5),
                Hazard(320, 300, 30, 30, move_range=50, speed=2),
            ]
            cheese_list = [
                Cheese(170, 400),
                Cheese(330, 300),
                Cheese(500, 400),
            ]
        else:
            player = Player(40, 500)
            door = Goal(720, 100)
            plat_list = [
                Platform(100, 460, 90, 20),
                Platform(220, 380, 90, 20),
                Platform(340, 300, 90, 20),
                Platform(460, 220, 90, 20),
                Platform(580, 160, 180, 20),
            ]
            hazard_list = [
                Hazard(120, 520, 40, 30, move_range=200, speed=4),
                Hazard(240, 350, 30, 30, move_range=40, speed=3),
                Hazard(480, 190, 30, 30, move_range=50, speed=3),
            ]
            cheese_list = [
                Cheese(120, 430),
                Cheese(240, 350),
                Cheese(360, 270),
                Cheese(600, 130),
            ]

        for p in plat_list:
            platforms.add(p)
            all_sprites.add(p)
        for h in hazard_list:
            hazards.add(h)
            all_sprites.add(h)
        for c in cheese_list:
            cheeses.add(c)
            all_sprites.add(c)

        all_sprites.add(door)
        all_sprites.add(player)

        return all_sprites, platforms, hazards, cheeses, player, door


# Async Game Loop for Browser
async def main():
    font = pygame.font.SysFont("arial", 22, bold=True)
    level_mgr = LevelManager()
    touch = TouchControls()

    (
        all_sprites,
        platforms,
        hazards,
        cheeses,
        player,
        door,
    ) = level_mgr.load_level(level_mgr.current_level)

    game_state = "PLAYING"
    running = True

    while running:
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False
            elif event.type == pygame.KEYDOWN:
                if game_state in ["GAME_OVER", "WIN"] and event.key == pygame.K_r:
                    level_mgr.current_level = 1
                    (
                        all_sprites,
                        platforms,
                        hazards,
                        cheeses,
                        player,
                        door,
                    ) = level_mgr.load_level(1)
                    game_state = "PLAYING"

        if game_state == "PLAYING":
            touch.process()
            keys = pygame.key.get_pressed()

            player.handle_input(keys, touch)
            player.update(platforms)
            hazards.update()

            for h in hazards:
                if pygame.sprite.collide_rect(player, h):
                    if player.take_damage():
                        if player.health <= 0:
                            game_state = "GAME_OVER"

            collected = pygame.sprite.spritecollide(player, cheeses, True)
            for _ in collected:
                player.cheese_collected += 1

            if pygame.sprite.collide_rect(player, door):
                if level_mgr.current_level < level_mgr.max_level:
                    level_mgr.current_level += 1
                    prev_health = player.health
                    prev_score = player.cheese_collected
                    (
                        all_sprites,
                        platforms,
                        hazards,
                        cheeses,
                        player,
                        door,
                    ) = level_mgr.load_level(level_mgr.current_level)
                    player.health = prev_health
                    player.cheese_collected = prev_score
                else:
                    game_state = "WIN"

        screen.fill(COLOR_BG)
        all_sprites.draw(screen)
        touch.draw(screen)

        hud_text = font.render(
            f"Level: {level_mgr.current_level}/{level_mgr.max_level}   "
            f"HP: {'♥ ' * player.health}   "
            f"Cheese: {player.cheese_collected}",
            True,
            COLOR_UI,
        )
        screen.blit(hud_text, (20, 20))

        if game_state == "GAME_OVER":
            txt = font.render(
                "GAME OVER! Press 'R' to Restart", True, COLOR_HAZARD
            )
            screen.blit(
                txt, (SCREEN_WIDTH // 2 - 140, SCREEN_HEIGHT // 2 - 10)
            )
        elif game_state == "WIN":
            txt = font.render(
                "YOU ESCAPED THE HOUSE! Press 'R' to Play Again",
                True,
                COLOR_DOOR,
            )
            screen.blit(
                txt, (SCREEN_WIDTH // 2 - 210, SCREEN_HEIGHT // 2 - 10)
            )

        pygame.display.flip()
        clock.tick(FPS)
        await asyncio.sleep(0)  # Critical for Web/Pygbag compatibility

    pygame.quit()
    sys.exit()


if __name__ == "__main__":
    asyncio.run(main())
